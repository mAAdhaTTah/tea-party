# Docker on this Mac runs on four-of-four's daemon through the four-of-four
# Docker context. Connection sharing means one 1Password approval per
# 10 minutes instead of one per docker command.
Host four-of-four
	User drone
	ControlMaster auto
	ControlPath ~/.ssh/cm-%r@%h:%p
	ControlPersist 10m

Host *
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
