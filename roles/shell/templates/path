# Add homebrew’s installs to PATH

export PATH="{{ homebrew_prefix }}/bin:{{ homebrew_prefix }}/sbin:{{ homebrew_prefix }}/opt/coreutils/libexec/gnubin:{{ homebrew_prefix }}/opt/findutils/libexec/gnubin:/Applications/Obsidian.app/Contents/MacOS:$PATH"

if [ -d "$HOME/.bin" ] ; then
    export PATH="$HOME/.bin:$PATH"
fi

export MANPATH="{{ homebrew_prefix }}/opt/coreutils/libexec/gnuman:{{ homebrew_prefix }}/opt/findutils/libexec/gnuman:$MANPATH"
