[tools]
{% for tool in mise_tools %}
{% if tool.comment is defined %}
# {{ tool.comment }}
{% endif %}
{% set tool_key = ('"' + tool.name + '"') if ':' in tool.name else tool.name %}
{% if tool.trust_policy_excludes is defined %}
{{ tool_key }} = { version = "{{ tool.version }}", trust_policy_excludes = {{ tool.trust_policy_excludes | to_json }} }
{% else %}
{{ tool_key }} = "{{ tool.version }}"
{% endif %}
{% endfor %}

[settings]
idiomatic_version_file_enable_tools = {{ mise_idiomatic_version_file_tools | to_json }}
python.uv_venv_auto = "source"

[env]
{% raw %}UV_PYTHON = { value = "{{ tools.python.path }}", tools = true }
{% endraw %}UV_PYTHON_DOWNLOADS = "never"
